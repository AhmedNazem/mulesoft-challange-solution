    {
      "name": "Create customer - 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"has X-Correlation-ID header\", () => pm.expect(pm.response.headers.has(\"X-Correlation-ID\")).to.be.true);",
              "pm.test(\"server fields\", () => { const b = pm.response.json(); pm.expect(b.customerId).to.match(/^CUST-/); pm.expect(b.status).to.eql(\"ACTIVE\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
