            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ahmed\",\n  \"lastName\": \"Nadhim\",\n  \"email\": \"ahmed.nadhim@example.com\",\n  \"mobileNumber\": \"+9647701234567\",\n  \"dateOfBirth\": \"1998-05-14\",\n  \"address\": {\n    \"city\": \"Baghdad\",\n    \"country\": \"Iraq\",\n    \"postalCode\": \"10001\"\n  }\n}\n"
