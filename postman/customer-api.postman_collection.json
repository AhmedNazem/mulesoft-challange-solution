{
  "info": {
    "name": "Customer API (Mule)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    }
  ],
  "item": [
    {
      "name": "List customers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"has X-Correlation-ID header\", () => pm.expect(pm.response.headers.has(\"X-Correlation-ID\")).to.be.true);",
              "pm.test(\"count matches list\", () => { const b = pm.response.json(); pm.expect(b.count).to.eql(b.customers.length); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers"
          ]
        }
      }
    },
    {
      "name": "Get customer - 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"has X-Correlation-ID header\", () => pm.expect(pm.response.headers.has(\"X-Correlation-ID\")).to.be.true);",
              "pm.test(\"customerId\", () => pm.expect(pm.response.json().customerId).to.eql(\"CUST-10001\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
